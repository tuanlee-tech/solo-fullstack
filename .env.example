# Sao chép file này thành .env và điền giá trị thật
# cp .env.example .env

# URL của site — dùng khi muốn test OG image và sitemap ở local với domain cụ thể
# Nếu để trống, astro.config.mjs tự fallback về http://localhost:4321
# SITE_URL=http://localhost:4321

# Cloudflare Pages tự inject biến này khi build — KHÔNG cần set thủ công
# CF_PAGES_URL=https://abc123.solo-fullstack.pages.dev
